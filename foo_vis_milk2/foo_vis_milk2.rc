// RCData
//

IDR_HELP_TEXT           RCDATA                  "..\\vis_milk2\\help.bin"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
FILEVERSION APPLICATION_VERSION_MAJOR, APPLICATION_VERSION_MINOR, APPLICATION_VERSION_BUILD, APPLICATION_VERSION_REVISION
PRODUCTVERSION LIBRARY_VERSION_MAJOR, LIBRARY_VERSION_MINOR, LIBRARY_VERSION_REVISION, LIBRARY_VERSION_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS _APPLICATION_VERSION_FILEFLAGS
FILEOS 0x40004L
FILETYPE _APPLICATION_VERSION_FILETYPE
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", APPLICATION_COMPANY_NAME
            VALUE "FileDescription", APPLICATION_DESCRIPTION
            VALUE "FileVersion", APPLICATION_VERSION
            VALUE "InternalName", APPLICATION_PRODUCT_NAME
            VALUE "LegalCopyright", "© " APPLICATION_COPYRIGHT
            VALUE "OriginalFilename", APPLICATION_FILE_NAME _APPLICATION_VERSION_EXTENSION
            VALUE "ProductName", APPLICATION_PRODUCT_NAME
            VALUE "ProductVersion", LIBRARY_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


