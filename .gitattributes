# Auto-detect text files and perform LF normalization.
* text=auto

# Explicitly declare code files as CRLF.
*.c eol=crlf
*.cpp eol=crlf
*.cmd eol=crlf
*.bat eol=crlf
*.h eol=crlf
*.hlsl eol=crlf
*.hlsli eol=crlf
*.fx eol=crlf
*.fxh eol=crlf
*.inc eol=crlf
*.inl eol=crlf
*.vcxproj eol=crlf
*.filters eol=crlf
*.sln eol=crlf
*.ps1 eol=crlf
*.sh eol=lf
*.yml eol=crlf
*.md eol=crlf

# Explicitly declare resource files as binary.
*.pdb binary
*.obj binary
*.cso binary

# Kept byte for byte, CRLF line endings and all: GitHub's "Download raw file" serves what the
# repository holds, and users download this file on its own to run it.
install-milkdrop2-plus.cmd -text